# PostgreSQL connection used by the app (copy to server/.env and adjust).
# The real development database is ags42_data (same as the AGS projects use).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ags42_data
DB_USER=postgres
DB_PASSWORD=postgres

# JWT signing secret — required; generate one per machine:
#   python -c "import secrets; print(secrets.token_hex(32))"
#JWT_SECRET_KEY=

# For the isolated end-to-end test database, create the scratch DB once:
#   psql -h 127.0.0.1 -U postgres -f server/scripts/init_local_db.sql
# then set DB_NAME=tdacdb here while running scripts/local_e2e*.sh, so test
# data never lands in ags42_data. Restore DB_NAME afterwards.
